# ==========================================================================
# CHRVVIM CAMPUS — نموذج متغيرات البيئة
# انسخ هذا الملف إلى .env ثم عدّل القيم. لا تشارك ملف .env مع أي جهة.
# ==========================================================================

# بيئة التشغيل: development أو production
NODE_ENV=development

# منفذ الخادم المحلي
PORT=3000

# مفتاح تشفير الجلسات: 32 حرفاً عشوائياً على الأقل.
# أنشئ واحداً بالأمر:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# سيُطلب إنشاء أول حساب مدير عند تشغيل npm run seed
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-with-14-chars-min

# مسار قاعدة البيانات (اختياري). افتراضياً: server/data/chrvvim.sqlite
# DATABASE_PATH=

# ==========================================================================
# مساعد صياغة الإعلانات بالذكاء الاصطناعي (اختياري تماماً)
# --------------------------------------------------------------------------
# اتركوه فارغاً ليعمل المساعد بصياغة محلية (قالب) بلا إنترنت وبلا مفتاح.
# للتفعيل اختر مزوّداً وضع مفتاحه:
#   AI_PROVIDER=gemini      (Google AI Studio — مزوّد افتراضي عند وجود مفتاح)
#   AI_PROVIDER=groq        (Groq — واجهة متوافقة مع OpenAI)
#   AI_PROVIDER=openai      (OpenAI)
#   AI_PROVIDER=openrouter  (OpenRouter)
#   AI_PROVIDER=custom      (أي واجهة متوافقة مع OpenAI: عيّن AI_BASE_URL)
# ==========================================================================

# AI_PROVIDER=gemini
# AI_API_KEY=
# AI_MODEL=gemini-2.0-flash
# AI_BASE_URL=
# AI_TIMEOUT_MS=20000
